rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Only actual admins have full access to works, projects, contacts
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isPartner() {
      return isAuthenticated() && getUserData().role == 'partner';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS (Partners & Admins)
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile. Admins can read all.
      allow read: if isOwner(userId) || isAdmin();
      // Users can update their own profile. Admins can create/update all.
      allow update: if isOwner(userId) || isAdmin();
      // Only admins or new signups (via Cloud Functions/direct creation if allowed) can create.
      // Assuming frontend creates the user doc on signup. It must match their own uid.
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // ==========================================
    // REFERRALS
    // ==========================================
    match /referrals/{referralId} {
      // Partners can read/update if the referral belongs to them (via referralCode)
      allow read, update: if (isPartner() && resource.data.referralCode == getUserData().referralCode) || isAdmin();
      
      // ANYONE can create a referral (since the client submits it via the link form)
      allow create: if true;
      
      allow delete: if isAdmin();
    }

    // ==========================================
    // COMMISSIONS
    // ==========================================
    match /commissions/{commissionId} {
      // Partners can read their own commissions.
      allow read: if (isPartner() && resource.data.partnerId == request.auth.uid) || isAdmin();
      // Only admins can create/update/delete commissions.
      allow write: if isAdmin();
    }

    // ==========================================
    // PAYOUTS
    // ==========================================
    match /payouts/{payoutId} {
      // Partners can read their own payouts.
      allow read: if (isPartner() && resource.data.partnerId == request.auth.uid) || isAdmin();
      // Partners can request payouts.
      allow create: if (isPartner() && request.resource.data.partnerId == request.auth.uid) || isAdmin();
      // Only admins can update/delete (e.g., mark as Paid).
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // ACTIVITY LOGS
    // ==========================================
    match /activity_logs/{logId} {
      allow read: if (isPartner() && resource.data.partnerId == request.auth.uid) || isAdmin();
      allow create: if (isPartner() && request.resource.data.partnerId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // WORKS (Portfolio Projects)
    // ==========================================
    match /works/{workId} {
      // Anyone can read the works to display them on the landing page
      allow read: if true;
      // ONLY authenticated admins can create, edit, or delete works
      allow write: if isAdmin();
    }

    // ==========================================
    // PROJECTS (Leads from Start a Project Wizard)
    // ==========================================
    match /projects/{projectId} {
      // Anyone can submit a project request
      allow create: if true;
      // ONLY authenticated admins can read, update, or delete the leads
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // CONTACTS (Queries from Contact Now form)
    // ==========================================
    match /contacts/{contactId} {
      // Anyone can submit a contact form
      allow create: if true;
      // ONLY authenticated admins can read, update, or delete the contacts
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // VENTURE APPLICATIONS (program subdomain survey)
    // ==========================================
    match /venture_applications/{appId} {
      // Anyone can submit an application, with basic shape checks
      allow create: if request.resource.data.keys().size() < 30
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.pitch is string && request.resource.data.pitch.size() <= 140
        && request.resource.data.problem is string && request.resource.data.problem.size() <= 1200
        && request.resource.data.why is string && request.resource.data.why.size() <= 1200
        && request.resource.data.status == 'new';
      // ONLY authenticated admins can read, update, or delete applications
      allow read, update, delete: if isAdmin();
    }

    // Default deny all for any other unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
